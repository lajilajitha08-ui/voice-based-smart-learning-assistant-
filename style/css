/* style.css */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #222;
    text-align: center;
}

header {
    background: #4f46e5;
    color: white;
    padding: 30px 20px;
}

header h1 {
    font-size: 32px;
    margin-bottom: 10px;
}

header p {
    font-size: 18px;
}

.container {
    max-width: 700px;
    margin: 50px auto;
    padding: 35px;
    background: white;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
}

.container h2 {
    margin-bottom: 15px;
}

.container p {
    margin-bottom: 25px;
}

button {
    padding: 15px 30px;
    border: none;
    border-radius: 30px;
    background: #4f46e5;
    color: white;
    font-size: 17px;
    cursor: pointer;
    transition: 0.3s;
}

button:hover {
    background: #3730a3;
    transform: scale(1.05);
}

#question,
#answer {
    margin-top: 25px;
    padding: 18px;
    background: #f1f5f9;
    border-radius: 10px;
    min-height: 50px;
    text-align: left;
}

#answer {
    border-left: 5px solid #4f46e5;
}

footer {
    margin-top: 60px;
    padding: 20px;
    background: #222;
    color: white;
}

@media (max-width: 600px) {
    .container {
        margin: 30px 15px;
        padding: 25px;
    }

    header h1 {
        font-size: 24px;
    }
}
